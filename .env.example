# ─────────────────────────────────────────────────────────────
# MT2 Lab configuration. Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

# Public address of the site, no trailing slash. Used in emails and payment redirects.
SITE_URL=http://localhost:3000

# Your domain without https:// (used by Caddy in docker-compose.yml to get the HTTPS certificate).
DOMAIN=

# Database. SQLite by default (a single file, easy to back up).
# Relative paths are resolved from the prisma/ folder.
DATABASE_URL="file:./dev.db"

# Where uploaded lot report PDFs and images are stored (keep it outside the app folder in production).
UPLOAD_DIR=./uploads

# ── Service keys ─────────────────────────────────────────────
# Email, Stripe, the AI key and address lookup can all be left empty here: owners can enter
# them in Admin › Settings › Connections instead, where they are stored encrypted with
# ENCRYPTION_KEY. A value set in this file always takes priority over the admin page.

# ── Email (SMTP) ─────────────────────────────────────────────
# Without email details, emails are recorded in Admin › Emails instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MT2 Lab <orders@example.co.uk>"

# ── Card payments (Stripe Checkout, includes Apple Pay and Google Pay) ──
# Leave empty to take bank transfer only. Check your processor accepts research-chemical merchants.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Chat assistant (optional) ────────────────────────────────
# Without a key the assistant answers from built-in replies.
# CHAT_MODEL defaults to Claude Opus 5.5; claude-haiku-5-5 is a much cheaper option for a shop chat.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# ── UK address lookup at checkout (optional, ideal-postcodes.co.uk) ──
IDEAL_POSTCODES_API_KEY=

# ── First admin account (optional) ───────────────────────────
# If set, the first start creates this owner account. Remove the password afterwards.
# Otherwise run: npm run admin:create -- --link you@example.com "Your Name"
# which prints a one-time link where you choose your own password.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ── Encryption ───────────────────────────────────────────────
# Encrypts affiliate bank details and the keys saved under Settings › Connections.
# Generate with: openssl rand -base64 32
# Back it up somewhere safe (a password manager): if it is lost, saved bank details
# cannot be read: affiliates have to enter bank details again and you re-enter the keys.
ENCRYPTION_KEY=

# ── Scheduled maintenance ────────────────────────────────────
# Call GET /api/cron?key=CRON_SECRET hourly to cancel expired unpaid orders and
# approve affiliate commission whose hold period has ended.
CRON_SECRET=
