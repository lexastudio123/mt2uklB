{
  "name": "mt2-lab",
  "version": "1.0.0",
  "private": true,
  "description": "MT2 Lab storefront and admin CRM",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@prisma/client": "6.19.3",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
